#!/usr/bin/env bash
# lanes — Claude Code multi-worktree dispatcher.
set -euo pipefail

SKILL="${LANES_SKILL_DIR:-$HOME/.claude/skills/lanes/scripts}"

# merge_next: pick the safest lane (one ranking scan) and integrate it.
merge_next() {
  local lane
  lane="$("$SKILL/integrate-next.sh" pick)"
  if [ -z "$lane" ]; then
    echo "No lanes have unintegrated commits. Nothing to merge."
    exit 0
  fi
  echo
  exec "$SKILL/merge-lane.sh" "$lane"
}

# run_claude <worktree> <claude args...>: run Claude, then offer to commit any
# work it left uncommitted in <worktree>, and exit with Claude's status.
run_claude() {
  local wt="$1" rc=0
  shift
  claude "$@" || rc=$?
  "$SKILL/offer-commit.sh" "$wt" || true
  exit "$rc"
}

cmd="${1:-merge}"
shift || true

case "$cmd" in
  start)
    # No name (or only claude flags): name the lane after the current time.
    if [ -z "${1:-}" ] || [[ "$1" == -* ]]; then
      lane="lane-$(date +%Y%m%d-%H%M%S)"
    else
      lane="$1"; shift
      # A renamed lane keeps its timestamp dir; reopen that worktree by name.
      . "$SKILL/lib.sh"
      dir="$(lane_dir "$(resolve_lane "$lane" || true)")"
      [[ "$dir" == */.claude/worktrees/* ]] && lane="$(basename "$dir")"
    fi
    run_claude "$(git rev-parse --show-toplevel)/.claude/worktrees/$lane" --worktree "$lane" "$@"
    ;;
  open)
    # Existing lanes only; resume the lane's last conversation when it has one.
    lane=""
    if [ -n "${1:-}" ] && [[ "$1" != -* ]]; then lane="$1"; shift; fi
    dir="$("$SKILL/open-lane.sh" "$lane")" || exit 1
    . "$SKILL/lib.sh"
    cd "$dir"
    if has_claude_session "$dir"; then
      run_claude "$dir" --continue "$@"
    else
      echo "No earlier conversation in $(basename "$dir"); starting a new one."
      run_claude "$dir" "$@"
    fi
    ;;
  dirty)
    exec "$SKILL/dirty.sh"
    ;;
  monitor)
    "$SKILL/status.sh" "${1:-main}"
    echo
    "$SKILL/overlap.sh" "${1:-main}"
    ;;
  log)
    exec "$SKILL/log-lanes.sh" "${1:-main}"
    ;;
  list)
    exec "$SKILL/lanes.sh" "${1:-main}"
    ;;
  inspect)
    lane="${1:-}"
    [ -z "$lane" ] && { echo "usage: lanes inspect <lane>"; exit 1; }
    exec "$SKILL/status.sh" main "$lane"
    ;;
  next)
    merge_next
    ;;
  next-all)
    hours="${1:-24}"
    [[ "$hours" =~ ^[0-9]+$ ]] || { echo "usage: lanes next-all [hours]"; exit 1; }
    lanes="$("$SKILL/integrate-next.sh" recent "$hours")"
    if [ -z "$lanes" ]; then
      echo "No lanes with commits from the last $hours hour(s) to merge."
      exit 0
    fi
    total="$(printf '%s\n' "$lanes" | grep -c .)"
    echo "Merging $total lane(s) from the last $hours hour(s), safest first:" $lanes
    i=0
    for lane in $lanes; do
      i=$((i + 1))
      echo
      echo "==> [$i/$total] $lane"
      if ! "$SKILL/merge-lane.sh" --yes "$lane"; then
        echo
        . "$SKILL/lib.sh"
        if merge_in_progress; then
          echo "Stopped at $lane ($i/$total) on a conflict. Once it's resolved, rerun"
          echo "'lanes next-all' for the rest."
        else
          echo "Stopped at $lane ($i/$total) without a conflict: merging it failed"
          echo "(see the output above) and nothing is in progress, so 'lanes resolve'"
          echo "has nothing to do. Fix the cause, then rerun 'lanes next-all'."
        fi
        exit 1
      fi
    done
    echo
    echo "Merged $total lane(s). Nothing has been pushed; run your tests."
    ;;
  resolve|fix)
    exec "$SKILL/resolve.sh" "$@"
    ;;
  diff)
    if [ $# -eq 0 ]; then
      echo "usage: lanes diff [--stat] <lane>"
      echo "       lanes diff [--stat] next"
      exit 1
    fi
    # Find the lane arg (first non-flag) so 'next' can be expanded.
    args=()
    lane_arg=""
    for a in "$@"; do
      case "$a" in
        -*) args+=("$a") ;;
        *)  if [ -z "$lane_arg" ]; then lane_arg="$a"; else args+=("$a"); fi ;;
      esac
    done
    if [ "$lane_arg" = "next" ]; then
      lane_arg="$("$SKILL/integrate-next.sh" pick)"
      if [ -z "$lane_arg" ]; then
        echo "No lanes have unintegrated commits. Nothing to diff."
        exit 0
      fi
    fi
    exec "$SKILL/diff-lane.sh" "${args[@]}" "$lane_arg"
    ;;
  merge)
    if [ $# -eq 0 ]; then
      exec "$SKILL/integrate-next.sh" list
    fi
    [ "${1:-}" = "next" ] && merge_next
    exec "$SKILL/merge-lane.sh" "$@"
    ;;
  drop)
    if [ $# -eq 0 ]; then
      echo "usage: lanes drop <lane> [--force]"
      exit 1
    fi
    exec "$SKILL/drop-lane.sh" "$@"
    ;;
  archive)
    exec "$SKILL/archive-lane.sh" "$@"
    ;;
  unarchive)
    [ $# -eq 0 ] && { echo "usage: lanes unarchive <lane>..."; exit 1; }
    exec "$SKILL/archive-lane.sh" --undo "$@"
    ;;
  union)
    if [ $# -eq 0 ]; then
      cat <<'EOF'
usage: lanes union <path> [<path>...]

Marks paths with git's 'union' merge driver in this repo's
.git/info/attributes (local to your clone, not committed). Append-only
logs (UX_LOG.md, CHANGELOG.md, etc.) auto-concatenate on merge instead
of producing conflicts.

Example:
  lanes union UX_LOG.md
  lanes union UX_LOG.md CHANGELOG.md docs/RELEASES.md

To share with the team, commit `<path> merge=union` to .gitattributes
instead of running this command.
EOF
      exit 1
    fi
    git_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || {
      echo "Not in a git repository."
      exit 1
    }
    attrs="$git_dir/info/attributes"
    mkdir -p "$git_dir/info"
    touch "$attrs"
    for path in "$@"; do
      line="$path merge=union"
      if grep -Fxq "$line" "$attrs"; then
        echo "already set: $line"
      else
        printf '%s\n' "$line" >> "$attrs"
        echo "added: $line"
      fi
    done
    echo
    echo "Wrote to $attrs (local to this clone, not committed)."
    ;;
  help|-h|--help)
    cat <<'EOF'
lanes — Claude Code multi-worktree dispatcher

CLI (run from your main worktree shell)

  Start
    lanes start <lane>     Launch Claude Code in a worktree (creates if needed)
    lanes start            Same, with a timestamp name like lane-20261016-143005
                           On exit, offers to commit any uncommitted work
    lanes open <lane>      Reopen an existing lane and resume its last
                           conversation (never creates a lane; suggests close
                           names on a typo). Also offers to commit on exit
    lanes open             Pick a lane from a list, most recent first

  Look around
    lanes monitor          Status + overlap across all lanes
    lanes log              Commit history for every lane
    lanes list             List worktrees and lane branches
    lanes dirty            List worktrees with uncommitted work (exit 1 if any)
    lanes inspect <lane>   Detail view of a single lane
    lanes diff <lane>      Show full diff a lane would land (merge-base...lane)
    lanes diff --stat <lane>  Same, summarized by file
    lanes diff next        Diff the safest lane (or 'lanes diff --stat next')

  Integrate
    lanes merge            Show lanes with commits to integrate (safest first)
    lanes                  Same as 'lanes merge'
    lanes merge <lane>     Integrate that lane into the current branch
    lanes next             Integrate the safest lane automatically
    lanes merge next       Same as 'lanes next'
    lanes next-all [hours] Integrate every lane committed in the last <hours>
                           (default 24), safest first, one at a time; stops
                           at the first conflict. Rerun it after resolving.
    lanes resolve          After a merge stops on a conflict, open Claude with
                           the lane, commits, conflicted files and handoff
                           notes so it can finish the job (alias: lanes fix)
    lanes drop <lane>      Retire a finished lane: remove its worktree and
                           delete its branch (refuses if it has unintegrated
                           work or a dirty tree; --force overrides)
    lanes archive <lane>...  Hide lanes from merge/next/next-all, keeping the
                           worktree and branch (a local git config flag)
    lanes archive --older <days>  Archive every lane idle longer than <days>
    lanes archive          List archived lanes
    lanes unarchive <lane>...  Show them again

  Conflict-free append-only files
    lanes union <path>...  Mark paths with git's 'union' merge driver in this
                           repo's .git/info/attributes (local, not committed).
                           Useful for UX_LOG.md, CHANGELOG.md, etc.

Slash commands (run inside a Claude Code lane)

  /checkpoint <msg>        Commit current changes with your message
  /wrap                    Auto-write a 1-2 sentence message and commit
  /handoff                 Update .claude-lane-status.md handoff notes

LANE NAMES

  Refer to lanes by their short name (the worktree dir): "esc", "feat-auth".
  The git branch is "worktree-<name>" (Claude Code's convention) — tooling
  resolves either form, so you almost never type the branch name.

RANKING

  "Safest" means: today's lanes before older ones, then lanes that merge
  cleanly before ones that would conflict, then fewest lines changed.
  Merging a lane whose last commit isn't from today prints a warning and,
  at an interactive terminal, asks before going on.

INTEGRATION MODE

  lanes merge picks the mode automatically based on how many *unintegrated*
  commits the lane has (patch-id aware, so re-integrating a lane after more
  work counts only the new commits):

    1-2 new commits  -> cherry-pick (linear history, no merge commit)
    3+  new commits  -> git merge --ff (merge commit only if target moved)

  A lane stops showing up to integrate once its content is on the current
  branch, even if a past conflict resolution changed a commit's patch-id: the
  listing runs a real 3-way merge and hides any lane that would not change the
  current branch. Use 'lanes drop <lane>' to also remove its worktree.

Nothing here pushes to GitHub. Only 'lanes drop' deletes a worktree/branch;
'lanes archive' only hides one.
EOF
    ;;
  *)
    echo "unknown subcommand: $cmd"
    echo "run: lanes help"
    exit 1
    ;;
esac
